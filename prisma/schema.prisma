// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  nama     String
  email    String @unique
  noHp     String @unique
  password String?
  role     String @default("USER")

  laporanSampah LaporanSampah[]
  petugas       Petugas?
}

model JenisSampah {
  id           String @id @default(uuid())
  namaJenis    String @unique
  kategoriId String?
  hargaPerKg Int @default(0)
  
  kategori     KategoriSampah? @relation(fields: [kategoriId], references: [id], onDelete: Restrict)
  laporanSampah LaporanSampah[]
}

model Wilayah {
  id           String @id @default(uuid())
  namaWilayah  String @unique

  laporanSampah LaporanSampah[]
}

model LaporanSampah {
  id            String @id @default(uuid())
  userId        String
  jenisSampahId String
  wilayahId     String
  statusId      String?
  deskripsi     String?
  beratKg       Float?
  hargaPerKgSaatDiterima Int?
  totalInsentif          Int?
  alamat        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime? @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  jenisSampah JenisSampah   @relation(fields: [jenisSampahId], references: [id], onDelete: Restrict)
  wilayah     Wilayah       @relation(fields: [wilayahId], references: [id], onDelete: Restrict)
  status      StatusLaporan? @relation(fields: [statusId], references: [id], onDelete: Restrict)

  fotoSampah          FotoSampah?
  penangananLaporan   PenangananLaporan[]
  penjemputan         Penjemputan?

 
}

model FotoSampah {
  id        String @id @default(uuid())
  laporanId String @unique
  fotoUrl   String?

  laporan LaporanSampah @relation(fields: [laporanId], references: [id], onDelete: Cascade)
}

model StatusLaporan {
  id           String @id @default(uuid())
  namaStatus   String @unique

  laporanSampah LaporanSampah[]
  penangananLaporan PenangananLaporan[]
}

model KategoriSampah {
  id            String @id @default(uuid())
  namaKategori  String @unique

  jenisSampah JenisSampah[]
}

model Petugas {
  id       String @id @default(uuid())
  userId   String @unique
  nama     String
  email    String @unique
  noHp     String @unique

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  penangananLaporan PenangananLaporan[]
  penjemputan       Penjemputan[]
}

model PenangananLaporan {
  id         String @id @default(uuid())
  laporanId  String
  petugasId  String
  statusId   String
  catatan    String?
  tanggal    DateTime @default(now())

  laporan LaporanSampah @relation(fields: [laporanId], references: [id], onDelete: Cascade)
  petugas Petugas       @relation(fields: [petugasId], references: [id], onDelete: Restrict)
  status  StatusLaporan @relation(fields: [statusId], references: [id], onDelete: Restrict)
}

model Penjemputan {
  id            String @id @default(uuid())
  laporanId     String @unique
  petugasId     String
  tanggalJemput DateTime?
  status        String @default("MENUNGGU")

  laporan LaporanSampah @relation(fields: [laporanId], references: [id], onDelete: Cascade)
  petugas Petugas       @relation(fields: [petugasId], references: [id], onDelete: Restrict)
}